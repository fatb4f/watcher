#!/usr/bin/env bash
set -euo pipefail

WATCHER_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
VPS_SECOPS_ROOT="${VPS_SECOPS_ROOT:-$HOME/src/vps_secops}"
PROFILE_CFG="${WATCHER_ROOT}/config/profiles_vps_secops.yaml"
export VPS_SECOPS_ROOT

if [[ ! -x "${VPS_SECOPS_ROOT}/scripts/vps_watcher_event_source.py" ]]; then
  echo "missing event source: ${VPS_SECOPS_ROOT}/scripts/vps_watcher_event_source.py" >&2
  exit 2
fi

exec "${WATCHER_ROOT}/bin/watchctl" daemon \
  --profiles "${PROFILE_CFG}" \
  --source-command "${VPS_SECOPS_ROOT}/scripts/vps_watcher_event_source.py --interval 30 --stale-seconds 900 --coverage-warn 60"
